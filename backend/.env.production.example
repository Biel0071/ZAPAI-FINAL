# ============================================================
# ZAPAI-CRM Backend — PRODUCTION EXAMPLE
# Copy to backend/.env.production and fill in real values.
# SECURITY: Do NOT commit real values to git.
#
# deploy/install.sh auto-generates this file on the VPS.
# ============================================================

# ── Public URL (FILL THIS IN FIRST) ───────────────────────────
# This is the single source of truth for CORS and Socket.IO.
# Example: APP_PUBLIC_URL=https://your-domain.com
#          APP_PUBLIC_URL=http://203.0.113.42
APP_PUBLIC_URL=http://YOUR_VPS_IP

# ── Runtime ────────────────────────────────────────────────────
NODE_ENV=production
PORT=4025
HOST=0.0.0.0

# ── CORS / Frontend URL ────────────────────────────────────────
FRONTEND_URL=http://YOUR_VPS_IP
CORS_ALLOWED_ORIGINS=http://YOUR_VPS_IP
ALLOWED_ORIGINS=http://YOUR_VPS_IP

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://zapai:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/zapai_crm
DB_POOL_MAX=10
DB_RUN_MIGRATIONS_ON_BOOT=true

# ── Authentication ─────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING
AUTH_JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING

AUTH_DEFAULT_USERNAME=zapadmin
AUTH_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
AUTH_DEFAULT_EMAIL=zapadmin@zapai.local
AUTH_DEFAULT_ROLE=master
AUTH_DEFAULT_TENANT_ID=default

# ── App ────────────────────────────────────────────────────────
DEFAULT_COMPANY_ID=default
NODE_ROLE=master
MASTER=true
FEATURE_ADMIN_MASTER=true
FEATURE_NODE_MASTER_API=true
FEATURE_NODE_AUTO_REGISTER=false

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=info
CRASH_EXIT_ON_UNHANDLED=true

# ── Rate Limiting ──────────────────────────────────────────────
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000

# ── WhatsApp ───────────────────────────────────────────────────
USE_NGROK=false
WHATSAPP_RESTORE_MODE=active_only
WHATSAPP_RESTORE_MAX_SESSIONS=10

# ── Optional ──────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# REDIS_URL=redis://localhost:6379
PM2_READY_SIGNAL=true
