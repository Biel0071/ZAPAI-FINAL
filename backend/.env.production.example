# ============================================================================
# BACKEND PRODUCTION ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.production and fill in your values
# DO NOT commit .env.production to git
# ============================================================================

# ============================================================================
# RUNTIME CONFIGURATION
# ============================================================================
NODE_ENV=production
# Porta travada em 4025 para produção
PORT=4025
HOST=0.0.0.0

# ── CORS / Frontend URL ──────────────────────────────────────
# FRONTEND_URL é a origem pública do app vista pelo navegador.
# CORS_ALLOWED_ORIGINS deve conter apenas as origens reais do frontend.
FRONTEND_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Database (PostgreSQL) ───────────────────────────────────
# Host `localhost` se o banco roda no host da VPS.
# Host `postgres` apenas se o backend roda dentro do docker-compose.
DATABASE_URL=postgresql://zapai:STRONG_PASSWORD@localhost:5432/zapai_crm
PGSSLMODE=disable

# ── Authentication ──────────────────────────────────────────
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING
AUTH_JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING

AUTH_DEFAULT_USERNAME=admin
AUTH_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
AUTH_DEFAULT_TENANT_ID=default

# ── Master Node Registration ─────────────────────────────────
MASTER=true
NODE_ROLE=master
MASTER_HOSTNAME=ZAP-AICRM
MASTER_VPS_IP=209.50.229.68
MASTER_API_URL=http://209.50.229.68:4025
NODE_TOKEN=CHANGE_ME_NODE_TOKEN
FEATURE_ADMIN_MASTER=true
FEATURE_NODE_MASTER_API=true
FEATURE_NODE_AUTO_REGISTER=false

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info

# ── Crash behavior ──────────────────────────────────────────
CRASH_EXIT_ON_UNHANDLED=true
