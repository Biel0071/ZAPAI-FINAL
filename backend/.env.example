# ============================================================
# ZAPAI-CRM Backend — Environment Variables
# Copy this file to .env and fill in real values before starting.
# NEVER commit .env to git.
# ============================================================

# ── Runtime ─────────────────────────────────────────────────
NODE_ENV=production
PORT=4025
# APP_PORT=4025                  # Alternative to PORT

# ── CORS / Frontend URL ──────────────────────────────────────
# Set to your VPS IP/domain. Multiple origins comma-separated.
# For VPS without nginx: http://YOUR_IP:3000
# For VPS with nginx:    http://YOUR_IP  or  https://your-domain.com
FRONTEND_URL=http://YOUR_IP:3000
CORS_ALLOWED_ORIGINS=http://YOUR_IP:3000

# ── Database (PostgreSQL) ───────────────────────────────────
# Option A — full connection string (preferred for VPS)
DATABASE_URL=postgresql://zapai:STRONG_PASSWORD@localhost:5432/zapai_crm

# Option B — individual vars (used if DATABASE_URL is absent)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=zapai_crm
# DB_USER=zapai
# DB_PASSWORD=STRONG_PASSWORD
# PGSSLMODE=disable                # Set to 'require' for remote DBs

# DB Pool tuning (optional)
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=10000
# DB_QUERY_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=5000
# DB_RUN_MIGRATIONS_ON_BOOT=false  # Set true to auto-migrate on start

# ── Authentication ──────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING
AUTH_JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING

AUTH_DEFAULT_USERNAME=admin
AUTH_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
AUTH_DEFAULT_TENANT_ID=default
# AUTH_DEFAULT_ROLE=master_admin   # admin | master_admin
# AUTH_TOKEN_TTL_SECONDS=28800    # 8 hours default

# ── Tenant ──────────────────────────────────────────────────
DEFAULT_COMPANY_ID=default

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
# OPENAI_MODEL=gpt-4.1-mini       # Default model

# ── WhatsApp Session Restore ────────────────────────────────
# WHATSAPP_RESTORE_MODE=active_only
# WHATSAPP_RESTORE_ACTIVE_ONLY=true
# WHATSAPP_RESTORE_MAX_SESSIONS=10
# WHATSAPP_RESTORE_SESSION_ALLOWLIST=

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
# LOG_CONSOLE_QUIET=false

# ── Crash behavior (prod: exit so PM2 can restart) ──────────
CRASH_EXIT_ON_UNHANDLED=true

# ── Admin Master (enterprise security) ───────────────────────
# Enable backend restart action from /api/admin/master only if explicitly set.
# Keep false by default for safety.
# ALLOW_ADMIN_BACKEND_RESTART=false
# PM2_BACKEND_PROCESS_NAME=zapai-backend

# ── Request limits ──────────────────────────────────────────
# DEFAULT_PAYLOAD_LIMIT=1mb
# MEDIA_PAYLOAD_LIMIT=25mb
# REQUEST_TIMEOUT_MS=30000

# ── Auth rate limiting ──────────────────────────────────────
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=60000

# ── Outbound message queue (optional tuning) ────────────────
# OUTBOUND_QUEUE_BASE_DELAY_MS=500
# OUTBOUND_QUEUE_JITTER_MS=200
# OUTBOUND_QUEUE_MAX_ATTEMPTS=3
# OUTBOUND_QUEUE_MAX_DELAY_MS=5000
# OUTBOUND_QUEUE_POLL_MS=100

# ── Cache/dedupe tuning (optional) ──────────────────────────
# MESSAGE_DEDUPE_MAX_ENTRIES=5000
# MESSAGE_DEDUPE_TTL_MS=60000
# CONVERSATION_CACHE_MAX_ENTRIES=500
# CONVERSATION_CACHE_TTL_MS=30000

# ── Enterprise features (optional — require Redis) ──────────
# Uncomment only if you have Redis and want enterprise queue/cache:
# REDIS_URL=redis://localhost:6379

# ── Runtime Agent (local dev only) ──────────────────────────
# RUNTIME_AGENT_PORT=4010
# RUNTIME_TARGET_PORT=4025
