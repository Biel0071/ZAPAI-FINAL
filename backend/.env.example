# ============================================================
# ZAPAI-CRM Backend — Environment Variables
# Copy this file to .env and fill in real values before starting.
# NEVER commit .env to git.
#
# For production: use backend/.env.production
#                 (generated by deploy/install.sh)
# ============================================================

# ── Runtime ─────────────────────────────────────────────────
NODE_ENV=development
PORT=4025
# APP_PORT=4025                  # Alternative to PORT

# ── Public URL (single source of truth for CORS) ─────────────
# In production: APP_PUBLIC_URL=https://your-domain.com
#                APP_PUBLIC_URL=http://YOUR_VPS_IP
# In development: leave empty or set to http://localhost:8080
APP_PUBLIC_URL=http://localhost:8080

# ── CORS / Frontend URL ──────────────────────────────────────
# In production these should match APP_PUBLIC_URL.
# In development, the Vite proxy handles CORS — localhost is fine.
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# ── Database (PostgreSQL) ───────────────────────────────────
# Option A — full connection string (preferred)
DATABASE_URL=postgresql://zapai:zapai_password@localhost:5432/zapai_crm

# Option B — individual vars (used if DATABASE_URL is absent)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=zapai_crm
# DB_USER=zapai
# DB_PASSWORD=zapai_password
# PGSSLMODE=disable

# DB Pool tuning (optional)
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=10000
# DB_QUERY_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=5000
# DB_RUN_MIGRATIONS_ON_BOOT=false

# ── Authentication ──────────────────────────────────────────
# PRODUCTION: generate with: openssl rand -hex 64
# DEVELOPMENT: use any strong random string
JWT_SECRET=dev_jwt_secret_replace_in_production
AUTH_JWT_SECRET=dev_auth_secret_replace_in_production

AUTH_DEFAULT_USERNAME=admin
AUTH_DEFAULT_PASSWORD=admin@123456
AUTH_DEFAULT_TENANT_ID=default
# AUTH_DEFAULT_ROLE=master

# ── Tenant ──────────────────────────────────────────────────
DEFAULT_COMPANY_ID=default

# ── OpenAI ──────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...your-key-here...

# ── WhatsApp Session Restore ────────────────────────────────
# WHATSAPP_RESTORE_MODE=active_only
# WHATSAPP_RESTORE_ACTIVE_ONLY=true
# WHATSAPP_RESTORE_MAX_SESSIONS=10

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
# LOG_CONSOLE_QUIET=false

# ── Crash behavior (prod: exit so PM2 can restart) ──────────
CRASH_EXIT_ON_UNHANDLED=true

# ── Request limits ──────────────────────────────────────────
# DEFAULT_PAYLOAD_LIMIT=1mb
# MEDIA_PAYLOAD_LIMIT=25mb
# REQUEST_TIMEOUT_MS=30000

# ── Auth rate limiting ──────────────────────────────────────
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=60000

# ── Enterprise features (optional — require Redis) ──────────
# REDIS_URL=redis://localhost:6379
