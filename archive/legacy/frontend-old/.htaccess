# ============================================================================
# CACHE HEADERS - APACHE
# ============================================================================
# 
# index.html: no cache
# assets com hash: cache longo imutável
# ============================================================================

# index.html - no cache
<FilesMatch "index\.html">
    Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# Assets com hash - cache longo imutável
<FilesMatch "assets/.*\.[a-f0-9]{8,}\.(js|css|png|jpg|jpeg|svg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    ExpiresActive On
    ExpiresDefault "access plus 1 year"
</FilesMatch>

# Outros assets - cache curto
<FilesMatch "\.(js|css|png|jpg|jpeg|svg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=86400"
</FilesMatch>

# Desabilitar ETag para assets com hash (já têm hash no nome)
<FilesMatch "assets/.*\.[a-f0-9]{8,}\.(js|css)$">
    FileETag None
</FilesMatch>
