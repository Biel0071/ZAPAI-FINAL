# Master Node Agent Configuration

# Master API URL (where this node is registered)
MASTER_API_URL=https://your-master-api.com/api

# Node credentials (provided by master after registration)
NODE_ID=your_node_id
NODE_TOKEN=your_node_token

# Local API port (the backend running on this node)
LOCAL_API_PORT=4025

# Heartbeat interval in milliseconds (default: 30000 = 30 seconds)
HEARTBEAT_INTERVAL=30000
