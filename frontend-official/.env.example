# ============================================================
# Frontend — Environment Variables EXAMPLE
# Copy to .env for local development.
#
# For production builds, .env.production is used automatically
# (VITE_API_URL=/ so nginx proxies /api/* to backend).
# ============================================================

# ── Local development ─────────────────────────────────────────
# Point to local backend (Vite dev server proxies this in dev mode)
VITE_API_URL=http://localhost:4025

# ── App version ───────────────────────────────────────────────
VITE_APP_VERSION=dev
VITE_APP_VERSION_LABEL=dev

# ── Demo data (dev only) ──────────────────────────────────────
VITE_ENABLE_DEMO_DATA=false

# ── Supabase (ONLY if using Supabase auth — not required for
#    the official backend JWT auth) ────────────────────────────
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
