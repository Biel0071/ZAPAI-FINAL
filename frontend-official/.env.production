# ============================================================
# Frontend — PRODUCTION build environment
# ============================================================
# In production (Nginx proxy setup):
#   - VITE_API_URL=/ means "use same origin as the page"
#   - Nginx proxies /api/* → backend:4025
#   - Socket.IO connects to window.location.origin (same origin)
#   - No hardcoded IPs or localhost in the production bundle
#
# deploy/install.sh writes this file automatically.
# You SHOULD NOT commit real values here — the install script
# regenerates this on every deploy.
# ============================================================

# API base — relative path, nginx proxies /api/* to backend
VITE_API_URL=/

# App version
VITE_APP_VERSION=1.2.0
VITE_APP_VERSION_LABEL=1.2.0

# Disable demo/mock data
VITE_ENABLE_DEMO_DATA=false
