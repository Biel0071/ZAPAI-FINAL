# ============================================================================
# CONFIG FIXA DE API - NÃO ALTERAR
# ============================================================================
# 
# Este arquivo contém variáveis de ambiente para API.
# 
# PROIBIDO:
# - Remover VITE_API_URL
# - Zerar VITE_API_URL
# - Trocar por mock URL
# 
# Para alterações visuais ou merge: NÃO TOCAR neste arquivo.
# ============================================================================

# Frontend Environment Variables
# Copy to .env (dev) or .env.production (prod) and fill values.
# NEVER commit .env / .env.production to git.
# ============================================================

# ── Backend API base URL ────────────────────────────────────
# In development: points to your local backend (no trailing slash)
# In production: points to your PUBLIC backend URL (e.g., https://api.yourdomain.com)
VITE_API_URL=http://localhost:4025

# Alias accepted by systemControlService / errorLogService / Diagnostics
# Set equal to VITE_API_URL unless you split services
VITE_WHATSAPP_API_BASE_URL=http://localhost:4025

# ── PRODUCTION CONFIGURATION ─────────────────────────────────
# Para produção, criar .env.production com:
# VITE_API_URL=https://api.yourdomain.com
# VITE_WHATSAPP_API_BASE_URL=https://api.yourdomain.com

# ── Supabase (used for auth helpers and direct DB reads) ────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...your-anon-key...
