# ==============================================================================
# ZAPFLOW AI — ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in the values.
# The install.sh script will generate secrets automatically.
# NEVER commit the actual .env file — it is in .gitignore.
# ==============================================================================

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=production
PORT=4025
API_PORT=4025
TZ=America/Sao_Paulo

# ── Domain / URLs ────────────────────────────────────────────
# Set to your actual domain (e.g., zapflow.example.com) for SSL.
# If no domain, use the VPS public IP (e.g., http://192.168.1.1).
DOMAIN=YOUR_DOMAIN_OR_IP
LETSENCRYPT_EMAIL=admin@yourdomain.com

# Frontend URL as seen by users (behind Nginx)
FRONTEND_URL=https://YOUR_DOMAIN_OR_IP
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN_OR_IP

# ── Frontend Build — CRITICAL ────────────────────────────────
# In production: ALWAYS use /api (Nginx proxies internally)
# In development: use http://localhost:4025 (direct to backend)
VITE_API_URL=/api
VITE_APP_VERSION=1.2.0-freeze
VITE_APP_VERSION_LABEL=1.2.0-freeze
VITE_ENABLE_DEMO_DATA=false

# ── Nginx ────────────────────────────────────────────────────
# Port exposed by Nginx (default 80 for VPS)
NGINX_PORT=80

# ── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_DB=zapai_crm
POSTGRES_USER=zapai
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_16
DATABASE_URL=postgresql://zapai:CHANGE_ME@postgres:5432/zapai_crm
PGSSLMODE=disable
DB_SSL=false
DB_WAIT_TIMEOUT_SECONDS=120
DB_WAIT_INTERVAL_SECONDS=2
DB_RUN_MIGRATIONS_ON_BOOT=true

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Authentication — CRITICAL ────────────────────────────────
# IMPORTANT: Generate unique secrets!
# Use: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
AUTH_JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Default admin credentials (seeded on first boot)
AUTH_DEFAULT_USERNAME=zapadmin
AUTH_DEFAULT_EMAIL=admin@admin.com
AUTH_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_12_CHARS
AUTH_DEFAULT_ROLE=master_admin
AUTH_DEFAULT_TENANT_ID=default

# ── Enterprise / Cluster ─────────────────────────────────────
MASTER=true
MASTER_HOSTNAME=ZAP-AICRM
MASTER_VPS_IP=YOUR_VPS_PUBLIC_IP
MASTER_PANEL_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_24
NODE_REGISTRATION_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_24

# ── Tenant ───────────────────────────────────────────────────
DEFAULT_COMPANY_ID=default

# ── WhatsApp ─────────────────────────────────────────────────
# Provider: baileys (default)
WHATSAPP_PROVIDER=baileys
WHATSAPP_DATA_DIR=./data/whatsapp

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
CRASH_EXIT_ON_UNHANDLED=true

# ── Backup ───────────────────────────────────────────────────
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# ── OpenAI (Optional) ───────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Email (Optional — for password recovery) ─────────────────
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@email.com
# SMTP_PASS=your_password
# EMAIL_FROM=noreply@zapflow.app
