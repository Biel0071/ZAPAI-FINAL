# ==============================================================================
# ZAPFLOW AI — PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env.production and fill in the values.
# The setup-vps.sh script will generate this automatically if it doesn't exist.
# ==============================================================================

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=production
PORT=4025

# ── Domain ───────────────────────────────────────────────────
# Set to your actual domain (e.g., zapflow.example.com) for SSL.
# If no domain, use the VPS public IP.
DOMAIN=YOUR_DOMAIN_OR_IP
LETSENCRYPT_EMAIL=admin@yourdomain.com

# ── URLs ─────────────────────────────────────────────────────
# Frontend URL as seen by users (Nginx reverse proxy)
FRONTEND_URL=http://YOUR_DOMAIN_OR_IP:3000
CORS_ALLOWED_ORIGINS=http://YOUR_DOMAIN_OR_IP:3000,http://YOUR_DOMAIN_OR_IP
# Used during frontend build to bake the API endpoint into the JS bundle
VITE_API_URL=http://YOUR_DOMAIN_OR_IP:3000

# ── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_DB=zapai_crm
POSTGRES_USER=zapai
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_16
DATABASE_URL=postgresql://zapai:CHANGE_ME@postgres:5432/zapai_crm
PGSSLMODE=disable
DB_SSL=false

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Authentication ───────────────────────────────────────────
# IMPORTANT: Generate unique secrets for production!
# Use: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
AUTH_JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Default admin credentials (seeded on first boot)
AUTH_DEFAULT_USERNAME=zapadmin
AUTH_DEFAULT_EMAIL=admin@admin.com
AUTH_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
AUTH_DEFAULT_ROLE=master_admin
AUTH_DEFAULT_TENANT_ID=default

# ── Enterprise / Cluster ─────────────────────────────────────
MASTER=true
MASTER_HOSTNAME=ZAP-AICRM
MASTER_VPS_IP=YOUR_IP
MASTER_PANEL_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_24
NODE_REGISTRATION_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_24

# ── Tenant ───────────────────────────────────────────────────
DEFAULT_COMPANY_ID=default

# ── Database Boot ────────────────────────────────────────────
DB_WAIT_TIMEOUT_SECONDS=120
DB_WAIT_INTERVAL_SECONDS=2
DB_RUN_MIGRATIONS_ON_BOOT=true

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
CRASH_EXIT_ON_UNHANDLED=true

# ── Backup ───────────────────────────────────────────────────
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# ── Timezone ─────────────────────────────────────────────────
TZ=America/Sao_Paulo

# ── OpenAI (Optional) ───────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Email (Optional — for password recovery) ─────────────────
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@email.com
# SMTP_PASS=your_password
# EMAIL_FROM=noreply@zapflow.app
