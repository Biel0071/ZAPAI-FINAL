# ============================================================
# ZAPAI ONE DEPLOY - PRODUCTION ENVIRONMENT TEMPLATE
# Copy to .env.production and update values.
# ============================================================

# Domain configuration
DOMAIN=your-domain.com
LETSENCRYPT_EMAIL=admin@your-domain.com
MASTER=true
MASTER_HOSTNAME=ZAP-AICRM
MASTER_VPS_IP=209.50.229.68

# Public URLs
FRONTEND_URL=https://your-domain.com
VITE_API_URL=http://209.50.229.68:4025
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Database
POSTGRES_USER=zapai
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=zapai_crm

# Auth secrets (generate secure values)
JWT_SECRET=change_me_min_64_chars_random_string
AUTH_JWT_SECRET=change_me_min_64_chars_random_string
AUTH_DEFAULT_USERNAME=admin
AUTH_DEFAULT_PASSWORD=change_me_admin_password
MASTER_PANEL_TOKEN=change_me_master_panel_token
NODE_REGISTRATION_TOKEN=change_me_node_registration_token

# Postgres backup scheduler
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# Runtime
NODE_ENV=production
LOG_LEVEL=info
CRASH_EXIT_ON_UNHANDLED=true
DB_WAIT_TIMEOUT_SECONDS=120
DB_WAIT_INTERVAL_SECONDS=2

# Optional integrations
USE_NGROK=false
NGROK_MANAGED_EXTERNALLY=true
DEFAULT_COMPANY_ID=default
