# ============================================================
# ZAPAI ONE DEPLOY - PRODUCTION ENVIRONMENT TEMPLATE
# Copy to .env.production and fill in your values.
#
# ARCHITECTURE MODE:
#   Backend-only (Lovable frontend): use docker-compose.backend-only.yml
#     → FRONTEND_URL = Lovable URL, VITE_API_URL is NOT needed
#   Full-stack (self-hosted frontend): use docker-compose.production.yml
#     → FRONTEND_URL and VITE_API_URL = your domain
# ============================================================

# Domain configuration (used by nginx-setup.sh for SSL)
DOMAIN=your-domain.com
LETSENCRYPT_EMAIL=admin@your-domain.com
MASTER=true
NODE_ROLE=master
MASTER_HOSTNAME=ZAP-AICRM
# Public IP of this VPS. Auto-detected by full-install.sh.
MASTER_VPS_IP=your-vps-ip

# ── Public URLs ────────────────────────────────────────────────────
# FRONTEND_URL: the origin of the frontend consuming this API.
#   Backend-only mode  → https://swift-wa-assist.lovable.app
#   Self-hosted mode   → https://your-domain.com
FRONTEND_URL=https://swift-wa-assist.lovable.app

# VITE_API_URL: ONLY used as a build-arg when building the frontend
# Docker image (docker-compose.production.yml). Not needed for
# docker-compose.backend-only.yml.
VITE_API_URL=https://your-domain.com

# CORS: comma-separated list of allowed origins.
# Always include every frontend URL that will call this API.
CORS_ALLOWED_ORIGINS=https://swift-wa-assist.lovable.app,https://your-domain.com

# Runtime feature flags (master/node)
FEATURE_ADMIN_MASTER=true
FEATURE_NODE_MASTER_API=true
FEATURE_NODE_AUTO_REGISTER=false

# ── Database ───────────────────────────────────────────────────────
POSTGRES_USER=zapai
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=zapai_crm
# 'disable' when Postgres runs on the same Docker network (standard Docker setup).
# 'require' only if using a managed external Postgres (RDS, Supabase, etc).
PGSSLMODE=disable

# ── Auth secrets (generate secure values) ──────────────────────────
JWT_SECRET=change_me_min_64_chars_random_string
AUTH_JWT_SECRET=change_me_min_64_chars_random_string
MASTER_PANEL_TOKEN=change_me_master_panel_token
NODE_REGISTRATION_TOKEN=change_me_node_registration_token

# ── Admin bootstrap (used by seed-admin.js on first run) ───────────
# The admin user created on first deploy. Change password after first login.
AUTH_DEFAULT_USERNAME=admin@admin.com
AUTH_DEFAULT_EMAIL=admin@admin.com
AUTH_DEFAULT_PASSWORD=change_me_admin_password
AUTH_DEFAULT_ROLE=master_admin
AUTH_DEFAULT_TENANT_ID=default

# Postgres backup scheduler
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# Runtime
NODE_ENV=production
LOG_LEVEL=info
CRASH_EXIT_ON_UNHANDLED=true
DB_WAIT_TIMEOUT_SECONDS=120
DB_WAIT_INTERVAL_SECONDS=2

# ── Optional integrations ───────────────────────────────────────────
DEFAULT_COMPANY_ID=default

# ── OpenAI (optional) ───────────────────────────────────────────────
# Required only for AI features (auto-heal, lead scoring, chat assistant).
# Leave empty to disable AI — the rest of the CRM works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
