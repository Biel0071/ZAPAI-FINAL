# ============================================================
# ZAPAI-FINAL — Root Production Environment EXAMPLE
#
# 1. Copy this file: cp .env.production.example .env.production
# 2. Fill in your VPS IP/domain and secrets
# 3. Run: sudo bash deploy/install.sh --domain=your-domain.com
#         (or without --domain for IP-only HTTP setup)
#
# SECURITY: .env.production must NOT be committed to git.
#
# ── Single source of truth for URLs ──────────────────────────
# APP_PUBLIC_URL drives CORS, Socket.IO origin, and frontend API base.
# With domain (recommended):  APP_PUBLIC_URL=https://your-domain.com
# IP-only (quick start):      APP_PUBLIC_URL=http://YOUR_VPS_IP
# ============================================================

# ── Public URL (FILL THIS IN FIRST) ───────────────────────────
APP_PUBLIC_URL=http://YOUR_VPS_IP

# ── Node identity ─────────────────────────────────────────────
MASTER=true
NODE_ROLE=master
MASTER_HOSTNAME=ZAPAI-PROD

# ── CORS / Frontend ───────────────────────────────────────────
# Must match APP_PUBLIC_URL in production
FRONTEND_URL=http://YOUR_VPS_IP
CORS_ALLOWED_ORIGINS=http://YOUR_VPS_IP
ALLOWED_ORIGINS=http://YOUR_VPS_IP

# ── Feature flags ─────────────────────────────────────────────
FEATURE_ADMIN_MASTER=true
FEATURE_NODE_MASTER_API=true
FEATURE_NODE_AUTO_REGISTER=false

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=zapai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=zapai_crm
DATABASE_URL=postgresql://zapai:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/zapai_crm

# For docker-compose, use 'postgres' hostname:
# DATABASE_URL=postgresql://zapai:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/zapai_crm

# ── Auth secrets ──────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Or:       openssl rand -hex 64
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING
AUTH_JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING

# ── Admin bootstrap (created on first deploy by seed-admin.js) ─
AUTH_DEFAULT_USERNAME=zapadmin
AUTH_DEFAULT_EMAIL=zapadmin@zapai.local
AUTH_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
AUTH_DEFAULT_ROLE=master
AUTH_DEFAULT_TENANT_ID=default

# ── App defaults ──────────────────────────────────────────────
DEFAULT_COMPANY_ID=default
NODE_ENV=production
PORT=4025
HOST=0.0.0.0

# ── Logging & crash policy ────────────────────────────────────
LOG_LEVEL=info
CRASH_EXIT_ON_UNHANDLED=true

# ── PM2 ───────────────────────────────────────────────────────
PM2_READY_SIGNAL=true
HEALTH_CHECK_INTERVAL_MS=60000

# ── Optional integrations ─────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
# REDIS_URL=redis://localhost:6379
