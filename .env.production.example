# ==============================================================
# ZAPFLOW AI — Production Environment Template
# Copy to .env.production and fill in real values.
# setup-vps.sh auto-generates this on first run.
# ==============================================================

# ── Domain & Network ─────────────────────────────────────────
DOMAIN=your-domain.com
LETSENCRYPT_EMAIL=admin@your-domain.com
MASTER=true
NODE_ROLE=master
MASTER_HOSTNAME=ZAP-PRODUCTION
MASTER_VPS_IP=0.0.0.0

# ── Public URLs ──────────────────────────────────────────────
# In production with nginx proxy, VITE_API_URL should be "/"
# nginx handles routing /api/* → backend:4025
FRONTEND_URL=https://your-domain.com
VITE_API_URL=/
CORS_ALLOWED_ORIGINS=https://your-domain.com,http://your-domain.com

# ── Feature Flags ────────────────────────────────────────────
FEATURE_ADMIN_MASTER=true
FEATURE_NODE_MASTER_API=true
FEATURE_NODE_AUTO_REGISTER=false

# ── Database ─────────────────────────────────────────────────
# CRITICAL: Use strong passwords in production!
POSTGRES_USER=zapai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=zapai_crm
PGSSLMODE=disable

# ── Auth Secrets ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_CHAR_HEX
AUTH_JWT_SECRET=CHANGE_ME_64_CHAR_HEX
MASTER_PANEL_TOKEN=CHANGE_ME_48_CHAR_HEX
NODE_REGISTRATION_TOKEN=CHANGE_ME_48_CHAR_HEX

# ── Admin Bootstrap ──────────────────────────────────────────
AUTH_DEFAULT_USERNAME=admin@your-domain.com
AUTH_DEFAULT_EMAIL=admin@your-domain.com
AUTH_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
AUTH_DEFAULT_ROLE=master_admin
AUTH_DEFAULT_TENANT_ID=default

# ── Backup ───────────────────────────────────────────────────
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
CRASH_EXIT_ON_UNHANDLED=true
DB_WAIT_TIMEOUT_SECONDS=120
DB_WAIT_INTERVAL_SECONDS=2
DEFAULT_COMPANY_ID=default

# ── WhatsApp Sessions ────────────────────────────────────────
# How many sessions to auto-restore on backend startup
WHATSAPP_RESTORE_MAX_SESSIONS=5
# Restore mode: "default" (restore from DB), "none", "persisted", "allowlist"
WHATSAPP_RESTORE_MODE=default
# Reconnect: max attempts before stopping (default: 5)
RECONNECT_MAX_ATTEMPTS=5

# ── Optional: AI ─────────────────────────────────────────────
OPENAI_API_KEY=

# ── Optional: Queue Mode ─────────────────────────────────────
# Set to "bullmq" for Redis-backed queues (requires REDIS_URL)
# Default is "in-memory" for single-node deployments
# QUEUE_MODE=in-memory

# ── VPS Kernel (add to /etc/sysctl.conf if needed) ───────────
# fs.inotify.max_user_watches=524288
# net.core.somaxconn=65535
