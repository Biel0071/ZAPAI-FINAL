# ============================================================
# ZAPFLOW AI — PRODUCTION ENVIRONMENT (TEMPLATE)
# ============================================================
# 1. Copy this file:   cp .env.production.example .env.production
# 2. Fill in your values below
# 3. NEVER commit .env.production to git
# ============================================================

# ── Domain & URLs ─────────────────────────────────────────────
# Replace with your actual domain (e.g. zapflow.meudominio.com)
DOMAIN=zapflow.meudominio.com
FRONTEND_URL=https://zapflow.meudominio.com
CORS_ALLOWED_ORIGINS=https://zapflow.meudominio.com
LETSENCRYPT_EMAIL=admin@meudominio.com

# ── Database (PostgreSQL) ─────────────────────────────────────
# These are used by both Docker Compose and the backend
POSTGRES_USER=zapai
POSTGRES_PASSWORD=TROQUE_PARA_UMA_SENHA_FORTE
POSTGRES_DB=zapai_crm
PGSSLMODE=disable

# ── Authentication ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=TROQUE_openssl_rand_hex_32
AUTH_JWT_SECRET=TROQUE_openssl_rand_hex_32

# Admin default (created on first boot)
AUTH_DEFAULT_USERNAME=zapadmin
AUTH_DEFAULT_EMAIL=admin@meudominio.com
AUTH_DEFAULT_PASSWORD=TROQUE_PARA_SENHA_FORTE
AUTH_DEFAULT_ROLE=master_admin
AUTH_DEFAULT_TENANT_ID=default

# ── Master Node ───────────────────────────────────────────────
MASTER=true
NODE_ROLE=master
MASTER_HOSTNAME=ZAP-AICRM
MASTER_VPS_IP=209.50.229.68
MASTER_API_URL=https://zapflow.meudominio.com
FEATURE_ADMIN_MASTER=true

# Generate with: openssl rand -hex 24
MASTER_PANEL_TOKEN=TROQUE_openssl_rand_hex_24
NODE_REGISTRATION_TOKEN=TROQUE_openssl_rand_hex_24

# ── Runtime ───────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
CRASH_EXIT_ON_UNHANDLED=true
DB_WAIT_TIMEOUT_SECONDS=120
DB_WAIT_INTERVAL_SECONDS=2

# ── Backup ────────────────────────────────────────────────────
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# ── Optional ──────────────────────────────────────────────────
OPENAI_API_KEY=
DEFAULT_COMPANY_ID=default
